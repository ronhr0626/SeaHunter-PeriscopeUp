<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SeaHunter"
        x:Class="SeaHunter.MainWindow"
        Title="SeaHunter: Periscope Up"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="Consolas">

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFD34D"/>
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8FB8DE"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.score">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#FFD34D"/>
            <Setter Property="Foreground" Value="#10202E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFE07A"/>
            <Setter Property="Foreground" Value="#10202E"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0B830"/>
            <Setter Property="Foreground" Value="#10202E"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- The game itself, always running underneath -->
        <local:GameCanvas x:Name="Game"/>

        <!-- ===== START SCREEN ===== -->
        <Border x:Name="StartScreen" Background="#CC00101C">
            <!-- Designed at 640x360 and scaled like the game -->
            <Viewbox Stretch="Uniform">
                <Grid Width="640" Height="360" ColumnDefinitions="*,175" Margin="0">

                    <!-- Left: title, story, controls, ships -->
                    <StackPanel Margin="24,20,8,8" Spacing="2">
                        <TextBlock Classes="title" Text="SEA HUNTER"/>
                        <TextBlock Classes="heading" Text="PERISCOPE UP" FontSize="14" Foreground="#FFD34D" Margin="0,0,0,2"/>
                        <TextBlock Classes="body" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="You command a submarine. Sink as many ships as you can before their depth charges sink you."/>

                        <TextBlock Classes="heading" Text="CONTROLS"/>
                        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Classes="key" Text="A D / ← →"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="Move left and right"/>
                            <TextBlock Grid.Row="1" Classes="key" Text="W S / ↑ ↓"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="Dive and rise"/>
                            <TextBlock Grid.Row="2" Classes="key" Text="SPACE"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="Fire torpedo (5+, then reload)"/>
                            <TextBlock Grid.Row="3" Classes="key" Text="Q"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="body" Text="Bubble shield  /  periscope: hold Q to swing to the destroyer"/>
                            <TextBlock Grid.Row="4" Classes="key" Text="P / ESC"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="body" Text="Pause"/>
                        </Grid>

                        <TextBlock Classes="heading" Text="TARGETS"/>
                        <Grid ColumnDefinitions="90,40,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Classes="key" Text="PATROL BOAT"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="key" Text="450"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="body" Text="Far away, fast, drops charges"/>
                            <TextBlock Grid.Row="1" Classes="key" Text="FREIGHTER"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="key" Text="200"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Classes="body" Text="Unarmed"/>
                            <TextBlock Grid.Row="2" Classes="key" Text="BATTLESHIP"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="key" Text="50"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="body" Text="Close, takes 2 hits, drops charges"/>
                        </Grid>

                        <TextBlock Classes="body" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="3 lives. Every 1000 points = new level. When damaged: periscope up (3 torpedoes per level played), then limp home through the minefield. Make it home to earn 3 bubble shields (Q)."/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                            <Button Content="START" Click="OnStartClick" IsDefault="True"/>

                            <!-- Test mode: jump straight to any patrol and stage. No high score is saved. -->
                            <TextBlock Classes="body" Text="TEST:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <ComboBox x:Name="TestPatrolBox" SelectedIndex="0" FontSize="10" VerticalAlignment="Center">
                                <ComboBoxItem Content="Patrol 1 (lvl 1)"/>
                                <ComboBoxItem Content="Patrol 2 (lvl 5)"/>
                                <ComboBoxItem Content="Patrol 3 (lvl 10)"/>
                                <ComboBoxItem Content="Patrol 4 (lvl 15)"/>
                                <ComboBoxItem Content="Patrol 5 (lvl 20)"/>
                            </ComboBox>
                            <ComboBox x:Name="TestStageBox" SelectedIndex="0" FontSize="10" VerticalAlignment="Center">
                                <ComboBoxItem Content="1 Side view"/>
                                <ComboBoxItem Content="2 Periscope"/>
                                <ComboBoxItem Content="3 Minefield"/>
                            </ComboBox>
                            <Button Content="TEST" Click="OnTestClick" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: high scores -->
                    <StackPanel Grid.Column="1" Margin="0,24,8,8" Spacing="0">
                        <TextBlock Classes="heading" Text="HIGH SCORES"/>
                        <ItemsControl x:Name="StartHighScoreList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="score" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Border>

        <!-- ===== PERISCOPE INTRO SCREEN ===== -->
        <Border x:Name="PeriscopeIntroScreen" Background="#CC00101C" IsVisible="False">
            <Viewbox Stretch="Uniform">
                <Grid Width="640" Height="360">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Classes="title" Text="DAMAGED!" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LevelReachedText" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TorpedoCountText" FontSize="14" FontWeight="Bold"
                                   Foreground="#FFD34D" HorizontalAlignment="Center"/>
                        <TextBlock Classes="body" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Text="A D / ← → turn (hold = faster)   Hold Q = swing to the destroyer   SPACE fire"/>
                        <Button Content="PERISCOPE UP" Click="OnPeriscopeClick" IsDefault="True"
                                HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Border>

        <!-- ===== CRASH DIVE SCREEN (after the destroyer gets you in the periscope) ===== -->
        <Border x:Name="CrashDiveScreen" Background="#CC00101C" IsVisible="False">
            <Viewbox Stretch="Uniform">
                <Grid Width="640" Height="360">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Width="420">
                        <TextBlock Classes="title" Text="CRASH DIVE!" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Depth charges rocked the boat. You survived – but the hull is badly damaged."/>
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#FFD34D" HorizontalAlignment="Center"
                                   Text="Head for home!"/>
                        <TextBlock x:Name="PingInfoText" FontSize="13" Foreground="#80FF80" HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                        <TextBlock Classes="body" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="A minefield lies between you and the harbor. W S / ↑ ↓ change depth, D / → move forward, SPACE sonar ping, F flag the cell ahead. Numbers = mines around that cell."/>
                        <Button Content="CONTINUE" Click="OnCrashDiveContinueClick" IsDefault="True"
                                HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Border>

        <!-- ===== HOME SAFE SCREEN (made it through the minefield) ===== -->
        <Border x:Name="HomeSafeScreen" Background="#CC00101C" IsVisible="False">
            <Viewbox Stretch="Uniform">
                <Grid Width="640" Height="360">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Width="420">
                        <TextBlock Classes="title" Text="HOME SAFE!" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Repairs complete. The boat is ready for a new patrol."/>
                        <TextBlock x:Name="HomeScoreText" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#80D0FF" HorizontalAlignment="Center"
                                   Text="Reward: 3 bubble shields – press Q"/>
                        <Button Content="NEXT PATROL" Click="OnNextPatrolClick" IsDefault="True"
                                HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Border>

        <!-- ===== GAME OVER SCREEN ===== -->
        <Border x:Name="GameOverScreen" Background="#CC00101C" IsVisible="False">
            <Viewbox Stretch="Uniform">
                <Grid Width="640" Height="360" ColumnDefinitions="*,200">

                    <!-- Left: result, name entry and buttons -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="GameOverTitle" Classes="title" Text="GAME OVER" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FinalScoreText" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NewHighScoreText" Text="NEW HIGH SCORE!" FontSize="12"
                                   FontWeight="Bold" Foreground="#FFD34D" HorizontalAlignment="Center"
                                   IsVisible="False"/>

                        <!-- Shown when the score makes the list -->
                        <StackPanel x:Name="NameEntryPanel" Spacing="4" IsVisible="False" Margin="0,8,0,0">
                            <TextBlock Classes="heading" Text="YOU MADE THE LIST! ENTER YOUR NAME" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBox x:Name="NameBox" Width="150" MaxLength="12" FontSize="12"
                                         PlaceholderText="MAX 12 LETTERS"/>
                                <Button x:Name="SaveNameButton" Content="SAVE" Click="OnSaveNameClick" IsDefault="True"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="GameOverButtons" Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="PlayAgainButton" Content="PLAY AGAIN" Click="OnPlayAgainClick" IsDefault="True"/>
                            <Button Content="MENU" Click="OnMenuClick"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: top 15 -->
                    <StackPanel Grid.Column="1" Margin="0,24,8,8" Spacing="0">
                        <TextBlock Classes="heading" Text="HIGH SCORES"/>
                        <ItemsControl x:Name="GameOverHighScoreList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="score" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</Window>